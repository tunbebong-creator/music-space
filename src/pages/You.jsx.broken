            </h2>
            
            <p className="text-center text-gray-600 mb-6 leading-relaxed text-sm md:text-base">
              Ghi lại tâm trạng, nhận gợi ý AI và kết nối với cộng đồng yêu âm nhạc
            </p>

            {/* Luxury Benefits */}
            <div className="space-y-2.5 mb-6">
              <div className="flex items-center gap-3 text-gray-700">
                <div className="relative w-8 h-8 flex-shrink-0">
                  <div className="absolute inset-0 bg-gradient-to-br from-purple-200 to-purple-300 rounded-full blur-sm"></div>
                  <div className="relative w-full h-full rounded-full bg-gradient-to-br from-purple-50 to-purple-100 flex items-center justify-center shadow-sm">
                    <span className="text-base">📝</span>
                  </div>
                </div>
                <span className="text-sm font-medium">Nhật ký tâm trạng cá nhân</span>
              </div>
              
              <div className="flex items-center gap-3 text-gray-700">
                <div className="relative w-8 h-8 flex-shrink-0">
                  <div className="absolute inset-0 bg-gradient-to-br from-amber-200 to-amber-300 rounded-full blur-sm"></div>
                  <div className="relative w-full h-full rounded-full bg-gradient-to-br from-amber-50 to-amber-100 flex items-center justify-center shadow-sm">
                    <span className="text-base">✨</span>
                  </div>
                </div>
                <span className="text-sm font-medium">Gợi ý thông minh từ AI</span>
              </div>
              
              <div className="flex items-center gap-3 text-gray-700">
                <div className="relative w-8 h-8 flex-shrink-0">
                  <div className="absolute inset-0 bg-gradient-to-br from-blue-200 to-blue-300 rounded-full blur-sm"></div>
                  <div className="relative w-full h-full rounded-full bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center shadow-sm">
                    <span className="text-base">🎯</span>
                  </div>
                </div>
                <span className="text-sm font-medium">Theo dõi hoạt động & cộng đồng</span>
              </div>
            </div>

            {/* Luxury CTA */}
            <motion.button
              whileHover={{ scale: 1.02, y: -2 }}
              whileTap={{ scale: 0.98 }}
              onClick={() => setShowAuthModal(true)}
