            >
              <div className="absolute inset-0 bg-gradient-to-r from-blue-500 via-blue-600 to-blue-500 bg-[length:200%_100%] group-hover:animate-[shimmer_2s_ease-in-out_infinite]"></div>
              <span className="relative text-white font-semibold text-base md:text-lg drop-shadow-sm">
