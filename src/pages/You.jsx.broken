            className="mt-6 text-center"
          >
            <p className="text-white/90 text-sm mb-2 drop-shadow">Hành trình hoàn chỉnh</p>
            <div className="flex items-center justify-center gap-2">
              <a href={createPageUrl("We")} className="px-3 py-1.5 rounded-full bg-white/20 hover:bg-white/30 transition-colors text-sm text-white/95 backdrop-blur-sm shadow-lg">
