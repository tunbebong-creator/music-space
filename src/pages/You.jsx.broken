      </div>

      {/* Shimmer animation */}
      <style jsx>{`
        @keyframes shimmer {
          0% { background-position: 200% 0; }
          100% { background-position: -200% 0; }
        }
      `}</style>
      
      {/* Modern Auth Modal */}
      {console.log('Rendering ModernAuthModal with isOpen:', showModernAuthModal)}
      {showModernAuthModal && (
        <ModernAuthModal
          key="modal"
          isOpen={true}
          onClose={() => {
            console.log('Modal onClose called');
            setShowModernAuthModal(false);
          }}
          onSuccess={(user) => {
            console.log('Modal onSuccess called with user:', user);
            setUser(user);
            setShowModernAuthModal(false);
          }}
        />
      )}
    </div>
  );
}
